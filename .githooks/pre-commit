#!/usr/bin/env bash
# Prevent committing .env files or files that contain SECRET_KEY/DJANGO_SECRET_KEY literals
set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "${STAGED_FILES}" ] && exit 0

EXIT_CODE=0
for FILE in ${STAGED_FILES}; do
  # Skip deleted files
  if [[ "$FILE" == /dev/null ]]; then
    continue
  fi

  # Prevent committing any .env filename
  if [[ "$(basename "$FILE")" == ".env" ]] || [[ "$FILE" =~ \.env($|/) ]]; then
    echo "ERROR: Attempt to add an env file ($FILE). Don't commit .env; use .env.example and environment variables."
    EXIT_CODE=1
    continue
  fi

  # Check staged content for SECRET_KEY literals
  if git show ":$FILE" 2>/dev/null | grep -E -n "DJANGO_SECRET_KEY|SECRET_KEY" >/dev/null 2>&1; then
    echo "ERROR: Staged file '$FILE' contains 'SECRET_KEY' or 'DJANGO_SECRET_KEY' literal. Remove before committing."
    EXIT_CODE=1
  fi
done

if [ "$EXIT_CODE" -ne 0 ]; then
  echo "Commit aborted. Remove secrets or move them to environment variables."
  exit $EXIT_CODE
fi

exit 0
